<Window x:Class="ForzaFarm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FH6 Open Assist"
        Width="1120"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style x:Key="MacroCardStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="#303640" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Indicator" Background="Transparent" CornerRadius="3" />
                                <ContentPresenter Grid.Column="1"
                                                  Margin="14,0,0,0"
                                                  HorizontalAlignment="Stretch" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource PanelHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Indicator" Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModeCardStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="#3B424D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ModeCard" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ModeCard" Property="Background" Value="{StaticResource PanelHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ModeCard" Property="Background" Value="#26351B" />
                                <Setter TargetName="ModeCard" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="ModeCard" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ModeCard" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="30" FontWeight="Bold" Text="FH6 Open Assist" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="Selecione um BOT, ative-o e use F8 para executar/pausar. F9 encerra." />
                <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                    <Button Click="InstructionsButton_Click"
                            Background="#D9364D"
                            BorderBrush="#FF6A7D"
                            Foreground="White"
                            Content="Instruções" />
                    <Button x:Name="ActivateBotButton"
                            Click="ActivateBotButton_Click"
                            Background="#B8FF00"
                            BorderBrush="#D8FF6D"
                            Foreground="#101216"
                            Content="Ativar BOT" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Border MinWidth="92" Margin="0,0,8,0" Padding="14,8"
                        Background="{StaticResource PanelBrush}" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="11" Text="SP" />
                        <TextBlock x:Name="SkillPointsText" FontSize="20" FontWeight="Bold" Text="—" />
                    </StackPanel>
                </Border>
                <Border MinWidth="156" Margin="0,0,8,0" Padding="14,8"
                        Background="{StaticResource PanelBrush}" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="11" Text="CRÉDITOS" />
                        <TextBlock x:Name="CreditsText" FontSize="20" FontWeight="Bold" Text="—" />
                    </StackPanel>
                </Border>
                <Border Padding="14,9" Background="{StaticResource PanelBrush}" CornerRadius="18"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="10" Height="10" Margin="0,0,8,0" Fill="#89919D" />
                        <TextBlock x:Name="StatusText" FontWeight="SemiBold" Text="Parado" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Margin="0,0,0,10" FontSize="16" FontWeight="SemiBold" Text="Selecione o BOT" />

                    <RadioButton x:Name="SpMacro" GroupName="Macros" Tag="FarmarSp"
                                 Style="{StaticResource MacroCardStyle}" Checked="Macro_Checked">
                        <StackPanel>
                            <TextBlock FontSize="17" FontWeight="Bold" Text="1 - Skill Points" />
                            <TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                                       Text="Início rápido na rua e repetição contínua do EventLab 122697651. Requer Impreza 22B e Assistência Total já ativos." />
                            <TextBlock Margin="0,9,0,0" Foreground="{StaticResource AccentBrush}" Text="10 SP por corrida · F8 executa/pausa · F9 encerra" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="Macros" Tag="Farmar200kMin"
                                 Style="{StaticResource MacroCardStyle}" Checked="Macro_Checked">
                        <StackPanel>
                            <TextBlock FontSize="17" FontWeight="Bold" Text="2 - CR Glitch" />
                            <TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                                       Text="Reproduz a sequência Pulover com os temporizadores originais pelo controle virtual." />
                            <TextBlock Margin="0,9,0,0" Foreground="{StaticResource AccentBrush}"
                                       Text="Primeiro plano recomendado · segundo plano disponível" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="Macros" Tag="FarmarWheelspins"
                                 Style="{StaticResource MacroCardStyle}" Checked="Macro_Checked">
                        <StackPanel>
                            <TextBlock FontSize="17" FontWeight="Bold" Text="3 - WheelSpin Mad Mike" />
                            <TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                                       Text="Começa na tela inicial da garagem, lê os recursos e compra a quantidade possível de Mad Mike, sem iniciar outros BOTs." />
                            <TextBlock Margin="0,9,0,0" Foreground="{StaticResource AccentBrush}" Text="Cada compra: 30 SP + 100.000 CR" />
                        </StackPanel>
                    </RadioButton>

                    <TextBlock Margin="0,10,0,8" FontSize="16" FontWeight="SemiBold" Text="Modo de execução" />
                    <UniformGrid Columns="2">
                        <RadioButton x:Name="ForegroundMode" GroupName="InputModes" Tag="Foreground"
                                     Margin="0,0,5,0" IsChecked="True" Style="{StaticResource ModeCardStyle}"
                                     Checked="InputMode_Checked" Content="Primeiro plano" />
                        <RadioButton x:Name="BackgroundMode" GroupName="InputModes" Tag="BackgroundExperimental"
                                     Margin="5,0,0,0" Style="{StaticResource ModeCardStyle}"
                                     Checked="InputMode_Checked" Content="Segundo plano (teste)" />
                    </UniformGrid>
                    <TextBlock x:Name="InputModeDescription" Margin="0,8,0,0"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                               TextWrapping="Wrap"
                               Text="Traz o Forza para frente quando necessário. É o modo recomendado enquanto o segundo plano é calibrado." />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Log da execução" />
                        <Button Grid.Column="1" Padding="10,4" Click="ClearLog_Click" Content="Limpar" />
                    </Grid>
                    <TextBox x:Name="LogTextBox" Grid.Row="2" Padding="12" Background="#0C0E11"
                             BorderBrush="#303640" Foreground="#D5DAE1" FontFamily="Cascadia Mono, Consolas"
                             FontSize="12" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4">
            <TextBlock x:Name="DetailText" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedTextBrush}" TextAlignment="Right"
                       Text="Nenhum BOT selecionado" />
        </Grid>
    </Grid>
</Window>
