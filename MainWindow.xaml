<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FH6OpenAssist.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="FH6 Open Assist"
    mc:Ignorable="d">
    <Grid
        x:Name="MainContent"
        Background="{ThemeResource WindowBackgroundBrush}"
        Loaded="MainContent_Loaded"
        SizeChanged="MainContent_SizeChanged">
        <Grid.Resources>
            <LinearGradientBrush
                x:Key="BotImageGlintBrush"
                StartPoint="0,0"
                EndPoint="1,0">
                <GradientStop Color="#00FFFFFF" Offset="0" />
                <GradientStop Color="#00FFFFFF" Offset="0.24" />
                <GradientStop Color="#88FFFFFF" Offset="0.5" />
                <GradientStop Color="#00FFFFFF" Offset="0.76" />
                <GradientStop Color="#00FFFFFF" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush
                x:Key="BotImageTextOverlayBrush"
                StartPoint="0,0"
                EndPoint="0,1">
                <GradientStop Color="#2E000000" Offset="0" />
                <GradientStop Color="#68000000" Offset="0.55" />
                <GradientStop Color="#59000000" Offset="1" />
            </LinearGradientBrush>
            <Style
                x:Key="SelectionCardBaseStyle"
                TargetType="RadioButton">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="Background" Value="{ThemeResource PanelBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource PanelHoverBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid>
                                <Border
                                    x:Name="FocusRing"
                                    BorderBrush="{ThemeResource AccentBrush}"
                                    BorderThickness="2"
                                    CornerRadius="12"
                                    Opacity="0" />
                                <Border
                                    x:Name="CardContainer"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12">
                                    <ContentPresenter />
                                </Border>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Unchecked">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardContainer" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource PanelBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardContainer" Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource PanelHoverBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardContainer" Storyboard.TargetProperty="BorderThickness">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="1" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Checked">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardContainer" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource PanelHoverBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardContainer" Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardContainer" Storyboard.TargetProperty="BorderThickness">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="2" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="FocusStates">
                                        <VisualState x:Name="Focused">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="FocusRing"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="1"
                                                    Duration="0:0:0.05" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Unfocused" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style
                x:Key="BotSelectionCardStyle"
                TargetType="RadioButton">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Width" Value="320" />
                <Setter Property="Height" Value="154" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="#4DFFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid>
                                <Border
                                    x:Name="CardContainer"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12">
                                    <ContentPresenter />
                                </Border>
                                <Border
                                    x:Name="FocusRing"
                                    BorderBrush="{ThemeResource AccentBrush}"
                                    BorderThickness="2"
                                    CornerRadius="12"
                                    IsHitTestVisible="False"
                                    Opacity="0" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Unchecked">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardContainer" Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#4DFFFFFF" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardContainer" Storyboard.TargetProperty="BorderThickness">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="1" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Checked">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardContainer" Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardContainer" Storyboard.TargetProperty="BorderThickness">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="2" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="FocusStates">
                                        <VisualState x:Name="Focused">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.05" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Unfocused" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style
                x:Key="ModeSelectionCardStyle"
                BasedOn="{StaticResource SelectionCardBaseStyle}"
                TargetType="RadioButton">
                <Setter Property="Width" Value="140" />
                <Setter Property="Height" Value="54" />
                <Setter Property="Padding" Value="10" />
            </Style>
        </Grid.Resources>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid x:Name="PageLayout" Padding="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="HeaderGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon
                                FontSize="28"
                                Foreground="{ThemeResource AccentBrush}"
                                Glyph="&#xE7FC;" />
                            <TextBlock
                                Foreground="{ThemeResource TextBrush}"
                                FontSize="30"
                                FontWeight="SemiBold"
                                Text="FH6 Open Assist" />
                        </StackPanel>
                        <TextBlock
                            MaxWidth="620"
                            Foreground="{ThemeResource MutedTextBrush}"
                            Text="Automação assistida com controle seguro por F8 e F9."
                            TextWrapping="Wrap" />
                        <StackPanel Margin="0,6,0,0" Orientation="Horizontal" Spacing="8">
                            <Button
                                AutomationProperties.Name="Abrir instruções do BOT selecionado"
                                Click="InstructionsButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE897;" />
                                    <TextBlock Text="Instruções" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="ActivateBotButton"
                                AutomationProperties.HelpText="Arma o BOT selecionado para execução com F8"
                                Click="ActivateBotButton_Click"
                                Content="Ativar BOT"
                                Style="{StaticResource AccentButtonStyle}" />
                            <ComboBox
                                x:Name="ThemeComboBox"
                                Width="138"
                                AutomationProperties.Name="Tema da interface"
                                PlaceholderText="Tema"
                                SelectionChanged="ThemeComboBox_SelectionChanged">
                                <ComboBoxItem Content="Sistema" Tag="System" />
                                <ComboBoxItem Content="Claro" Tag="Light" />
                                <ComboBoxItem Content="Escuro" Tag="Dark" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        x:Name="HeaderResourcesPanel"
                        Grid.Column="1"
                        Margin="16,0,0,0"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Border
                            MinWidth="92"
                            Padding="14,9"
                            Background="{ThemeResource PanelBrush}"
                            CornerRadius="8">
                            <StackPanel>
                                <TextBlock Foreground="{ThemeResource MutedTextBrush}" FontSize="11" Text="SP" />
                                <TextBlock x:Name="SkillPointsText" Foreground="{ThemeResource TextBrush}" FontSize="20" FontWeight="SemiBold" Text="—" />
                            </StackPanel>
                        </Border>
                        <Border
                            MinWidth="146"
                            Padding="14,9"
                            Background="{ThemeResource PanelBrush}"
                            CornerRadius="8">
                            <StackPanel>
                                <TextBlock Foreground="{ThemeResource MutedTextBrush}" FontSize="11" Text="CRÉDITOS" />
                                <TextBlock x:Name="CreditsText" Foreground="{ThemeResource TextBrush}" FontSize="20" FontWeight="SemiBold" Text="—" />
                            </StackPanel>
                        </Border>
                        <Border
                            Padding="14,10"
                            Background="{ThemeResource PanelBrush}"
                            CornerRadius="8"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{ThemeResource StatusIdleBrush}" />
                                <TextBlock x:Name="StatusText" Foreground="{ThemeResource TextBrush}" FontWeight="SemiBold" Text="Parado" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <InfoBar
                    x:Name="ViGEmInfoBar"
                    Grid.Row="1"
                    Margin="0,16,0,0"
                    IsClosable="False"
                    IsOpen="False"
                    Message="O primeiro plano segue disponível com teclado e mouse nativos. Instale o ViGEmBus para liberar o segundo plano."
                    Severity="Warning"
                    Title="Segundo plano indisponível">
                    <InfoBar.ActionButton>
                        <Button Click="RetryViGEmButton_Click" Content="Tentar novamente" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <Grid x:Name="MainWorkArea" Grid.Row="2" Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="MainTopRow" Height="Auto" />
                        <RowDefinition x:Name="MainGapRow" Height="0" />
                        <RowDefinition x:Name="MainBottomRow" Height="0" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="MainLeftColumn" Width="380" />
                        <ColumnDefinition x:Name="MainGapColumn" Width="18" />
                        <ColumnDefinition x:Name="MainRightColumn" Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="BotSelectionPanel" Spacing="10">
                        <TextBlock Foreground="{ThemeResource TextBrush}" FontSize="18" FontWeight="SemiBold" Text="Escolha um BOT" />

                        <RadioButton
                            x:Name="SpMacro"
                            GroupName="Macros"
                            Style="{StaticResource BotSelectionCardStyle}"
                            Tag="FarmarSp"
                            Checked="Macro_Checked">
                            <Grid>
                                <Border
                                    x:Name="SpBotImageFrame"
                                    CornerRadius="11">
                                    <Grid>
                                        <Image
                                            x:Name="SpMacroImageGray"
                                            Source="ms-appx:///Assets/UI/Skill_Points.png"
                                            Stretch="UniformToFill" />
                                        <Image
                                            x:Name="SpMacroImageColor"
                                            Opacity="0"
                                            Source="ms-appx:///Assets/UI/Skill_Points.png"
                                            Stretch="UniformToFill" />
                                        <Border x:Name="SpMacroImageOverlay" Background="{StaticResource BotImageTextOverlayBrush}" />
                                        <Border
                                            x:Name="SpMacroImageGlint"
                                            Width="180"
                                            Height="300"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Background="{StaticResource BotImageGlintBrush}"
                                            IsHitTestVisible="False"
                                            Opacity="0"
                                            RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <RotateTransform Angle="-22" />
                                            </Border.RenderTransform>
                                        </Border>
                                        <StackPanel
                                            Margin="16,0"
                                            VerticalAlignment="Center"
                                            Spacing="4">
                                            <TextBlock Foreground="White" FontSize="17" FontWeight="SemiBold" Text="1 · Skill Points" />
                                            <TextBlock
                                                Foreground="#E6FFFFFF"
                                                FontSize="12"
                                                Text="Farma pontos de habilidade com corrida e repetição assistida."
                                                TextWrapping="Wrap" />
                                            <TextBlock Foreground="{ThemeResource AccentBrush}" FontSize="12" FontWeight="SemiBold" Text="Recurso: SP" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </RadioButton>

                        <RadioButton
                            x:Name="CrMacro"
                            GroupName="Macros"
                            Style="{StaticResource BotSelectionCardStyle}"
                            Tag="Farmar200kMin"
                            Checked="Macro_Checked">
                            <Grid>
                                <Border
                                    x:Name="CrBotImageFrame"
                                    CornerRadius="11">
                                    <Grid>
                                        <Image
                                            x:Name="CrMacroImageGray"
                                            Source="ms-appx:///Assets/UI/CR_Icon.png"
                                            Stretch="UniformToFill" />
                                        <Image
                                            x:Name="CrMacroImageColor"
                                            Opacity="0"
                                            Source="ms-appx:///Assets/UI/CR_Icon.png"
                                            Stretch="UniformToFill" />
                                        <Border x:Name="CrMacroImageOverlay" Background="{StaticResource BotImageTextOverlayBrush}" />
                                        <Border
                                            x:Name="CrMacroImageGlint"
                                            Width="180"
                                            Height="300"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Background="{StaticResource BotImageGlintBrush}"
                                            IsHitTestVisible="False"
                                            Opacity="0"
                                            RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <RotateTransform Angle="-22" />
                                            </Border.RenderTransform>
                                        </Border>
                                        <StackPanel
                                            Margin="16,0"
                                            VerticalAlignment="Center"
                                            Spacing="4">
                                            <TextBlock Foreground="White" FontSize="17" FontWeight="SemiBold" Text="2 · Farm de CR" />
                                            <TextBlock
                                                Foreground="#E6FFFFFF"
                                                FontSize="12"
                                                Text="Executa a rota calibrada para ganho recorrente de créditos."
                                                TextWrapping="Wrap" />
                                            <TextBlock Foreground="{ThemeResource AccentBrush}" FontSize="12" FontWeight="SemiBold" Text="Recurso: créditos" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </RadioButton>

                        <RadioButton
                            x:Name="WheelspinMacro"
                            GroupName="Macros"
                            Style="{StaticResource BotSelectionCardStyle}"
                            Tag="FarmarWheelspins"
                            Checked="Macro_Checked">
                            <Grid>
                                <Border
                                    x:Name="WheelspinBotImageFrame"
                                    CornerRadius="11">
                                    <Grid>
                                        <Image
                                            x:Name="WheelspinMacroImageGray"
                                            Source="ms-appx:///Assets/UI/WheelSpin.jpg"
                                            Stretch="UniformToFill" />
                                        <Image
                                            x:Name="WheelspinMacroImageColor"
                                            Opacity="0"
                                            Source="ms-appx:///Assets/UI/WheelSpin.jpg"
                                            Stretch="UniformToFill" />
                                        <Border x:Name="WheelspinMacroImageOverlay" Background="{StaticResource BotImageTextOverlayBrush}" />
                                        <Border
                                            x:Name="WheelspinMacroImageGlint"
                                            Width="180"
                                            Height="300"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Background="{StaticResource BotImageGlintBrush}"
                                            IsHitTestVisible="False"
                                            Opacity="0"
                                            RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <RotateTransform Angle="-22" />
                                            </Border.RenderTransform>
                                        </Border>
                                        <StackPanel
                                            Margin="16,0"
                                            VerticalAlignment="Center"
                                            Spacing="4">
                                            <TextBlock Foreground="White" FontSize="17" FontWeight="SemiBold" Text="3 · WheelSpin Mad Mike" />
                                            <TextBlock
                                                Foreground="#E6FFFFFF"
                                                FontSize="12"
                                                Text="Compra, melhora e gira carros pela sequência Mad Mike."
                                                TextWrapping="Wrap" />
                                            <TextBlock Foreground="{ThemeResource AccentBrush}" FontSize="12" FontWeight="SemiBold" Text="Recursos: SP e créditos" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </RadioButton>

                        <Border
                            Width="320"
                            Margin="0,6,0,0"
                            Padding="16"
                            HorizontalAlignment="Left"
                            Background="{ThemeResource PanelBrush}"
                            CornerRadius="8">
                            <StackPanel Spacing="8">
                                <TextBlock Foreground="{ThemeResource TextBrush}" FontSize="16" FontWeight="SemiBold" Text="Modo de execução" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <RadioButton
                                        x:Name="ForegroundMode"
                                        GroupName="InputModes"
                                        Style="{StaticResource ModeSelectionCardStyle}"
                                        Tag="Foreground"
                                        Checked="InputMode_Checked">
                                        <TextBlock
                                            Foreground="{ThemeResource TextBrush}"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Text="Primeiro plano" />
                                    </RadioButton>
                                    <RadioButton
                                        x:Name="BackgroundMode"
                                        GroupName="InputModes"
                                        Style="{StaticResource ModeSelectionCardStyle}"
                                        Tag="BackgroundExperimental"
                                        Checked="InputMode_Checked">
                                        <TextBlock
                                            Foreground="{ThemeResource TextBrush}"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Text="Segundo plano" />
                                    </RadioButton>
                                </StackPanel>
                                <TextBlock
                                    x:Name="InputModeDescription"
                                    Foreground="{ThemeResource MutedTextBrush}"
                                    FontSize="12"
                                    TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse x:Name="ViGEmStatusDot" Width="8" Height="8" Fill="{ThemeResource StatusIdleBrush}" VerticalAlignment="Center" />
                                    <TextBlock
                                        x:Name="ViGEmStatusText"
                                        Foreground="{ThemeResource MutedTextBrush}"
                                        FontSize="12"
                                        Text="Validando controle virtual…"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <HyperlinkButton
                                    x:Name="ViGEmOfficialLink"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.Name="Abrir página oficial do ViGEmBus"
                                    Click="ViGEmOfficialLink_Click"
                                    Content="Abrir página oficial do ViGEmBus"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                        <Border
                            Width="320"
                            Padding="12,8"
                            HorizontalAlignment="Left"
                            Background="{ThemeResource PanelBrush}"
                            BorderBrush="{ThemeResource PanelHoverBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="1">
                                    <TextBlock Foreground="{ThemeResource TextBrush}" FontSize="12" FontWeight="SemiBold" Text="☕ Apoie o projeto" />
                                    <TextBlock Foreground="{ThemeResource MutedTextBrush}" FontSize="11" Text="Contribuição voluntária para manter o FH6 Open Assist." />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    Padding="10,4"
                                    AutomationProperties.HelpText="Copiar chave PIX de apoio ao projeto"
                                    Click="CopySupportPixButton_Click"
                                    Content="Copiar PIX"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Border
                        x:Name="LogPanel"
                        Grid.Column="2"
                        MinHeight="480"
                        Padding="16"
                        Background="{ThemeResource PanelBrush}"
                        CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Foreground="{ThemeResource TextBrush}" FontSize="18" FontWeight="SemiBold" Text="Log da execução" />
                                    <TextBlock Foreground="{ThemeResource MutedTextBrush}" FontSize="12" Text="Eventos, calibração e liberação segura de entradas." />
                                </StackPanel>
                                <Button Grid.Column="1" Click="ClearLog_Click" Content="Limpar" />
                            </Grid>
                            <TextBox
                                x:Name="LogTextBox"
                                Grid.Row="2"
                                Padding="12"
                                AcceptsReturn="True"
                                AutomationProperties.Name="Log da execução"
                                Background="{ThemeResource LogBackgroundBrush}"
                                BorderBrush="{ThemeResource LogBorderBrush}"
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="12"
                                Foreground="{ThemeResource LogTextBrush}"
                                IsReadOnly="True"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="3" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="DetailText"
                        Foreground="{ThemeResource MutedTextBrush}"
                        Text="Selecione um BOT para começar."
                        TextWrapping="Wrap" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="16,0,0,0"
                        Foreground="{ThemeResource MutedTextBrush}"
                        Text="F8 iniciar/pausar  ·  F9 encerrar" />
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>

